# Copy this file to .env.local and fill in the values.
# .env.local is ignored by Git (see .gitignore) — never commit real values.

# Firebase web app "Carbon Choices Web" in project personal-carbon-tradeoff.
# Firebase console → Project settings → General → Your apps → SDK setup and configuration → Config.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=personal-carbon-tradeoff.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=personal-carbon-tradeoff
VITE_FIREBASE_STORAGE_BUCKET=your-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional: use the local Firebase emulators instead of the real project
# (start them with `npm run emulators`). The values above are then not needed.
# VITE_FIREBASE_USE_EMULATOR=true
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Optional: route distance providers (defaults are the free public OpenStreetMap services).
# VITE_GEOCODER_URL=https://nominatim.openstreetmap.org
# VITE_ROUTER_URL=https://routing.openstreetmap.de
# Optional contact email sent to Nominatim, as its usage policy recommends for heavy use.
# VITE_NOMINATIM_EMAIL=
